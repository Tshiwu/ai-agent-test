# 优先用 OpenAI；无响应或超时（约 8 秒）时自动改用 DeepSeek
NUXT_OPENAI_API_KEY=sk-xxx
# NUXT_OPENAI_BASE_URL=https://your-proxy.com/v1

# 备选：OpenAI 不可用时自动使用（国内可用，https://platform.deepseek.com）
NUXT_DEEPSEEK_API_KEY=sk-xxx

# OpenRouter（可选多种模型 https://openrouter.ai/models）
# NUXT_OPENROUTER_API_KEY=sk-or-v1-xxx
# NUXT_OPENROUTER_MODEL=openai/gpt-4o-mini

# 或 Vercel AI Gateway（需绑卡）
# NUXT_AI_GATEWAY_API_KEY=xxx
